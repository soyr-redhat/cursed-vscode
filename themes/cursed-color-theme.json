  "tokenColors": [
    {
      "name": "Comments, which nobody reads anyway",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol", "string.quoted"],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage", "storage.type"],
      "settings": {
        "foreground": "#FFFF00",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#0000FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#FF7F00",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable"],
      "settings": {
        "foreground": "#00FF00",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#9400D3",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Constants, struck through for no reason",
      "scope": ["constant", "constant.language", "variable.other.constant"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold strikethrough"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#9400D3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Invalid, somehow the most readable thing here",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold italic underline"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#FFFF00",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Everything else gets italics too",
      "scope": ["source", "text"],
      "settings": {
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#9400D3", "italic": true },
    "property": { "foreground": "#00FFFF", "bold": true },
    "class": { "foreground": "#FF7F00", "underline": true },
    "function": { "foreground": "#FFFFFF", "italic": true, "bold": true },
    "variable.readonly": { "foreground": "#FFFFFF", "strikethrough": true },
    "namespace": { "foreground": "#0000FF", "bold": true },
    "enumMember": { "foreground": "#FF0000", "italic": true }
  }
}
